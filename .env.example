# Optional compatibility override for every probe. Prefer the per-probe values below.
# ARGUS_INTERVAL_SECS=600
ARGUS_FAILURE_THRESHOLD=1
ARGUS_RECOVERY_THRESHOLD=1
RUST_LOG=argus=info,argus_server=info

GETLLM_BASE_URL=https://www.getllm.ai/v1
GETLLM_API_KEY=gl-live-your-key
GETLLM_ROUTE=cheapest
GETLLM_REQUEST_TIMEOUT_SECS=30

GETLLM_TEXT_ENABLED=true
GETLLM_TEXT_MODEL=gpt-4o-mini
GETLLM_TEXT_PROMPT="ping"
GETLLM_TEXT_MAX_TOKENS=1
GETLLM_TEXT_INTERVAL_SECS=60

GETLLM_IMAGE_ENABLED=true
GETLLM_IMAGE_MODEL=gpt-image-2
GETLLM_IMAGE_PROMPT="dot"
GETLLM_IMAGE_SIZE=1024x1024
GETLLM_IMAGE_QUALITY=low
GETLLM_IMAGE_RESPONSE_FORMAT=
GETLLM_IMAGE_TIMEOUT_SECS=180
GETLLM_IMAGE_INTERVAL_SECS=600

FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
FEISHU_SIGNING_SECRET=
FEISHU_TIMEOUT_SECS=10
